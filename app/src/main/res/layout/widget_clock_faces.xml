<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="52dp" android:clipChildren="false" android:clipToPadding="false">
    <TextClock android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
    <TextClock android:id="@+id/widget_time_light" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_serif" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="serif" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_mono" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="monospace" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_black" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_condensed" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_rounded" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-rounded" android:includeFontPadding="false" android:visibility="gone" />
    <TextClock android:id="@+id/widget_time_casual" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|center_horizontal" android:format12Hour="h:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="casual" android:includeFontPadding="false" android:visibility="gone" />
</FrameLayout>
