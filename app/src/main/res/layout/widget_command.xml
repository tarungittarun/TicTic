<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_widget_command" android:clipChildren="false">
    <ImageView android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_fill_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_gloss" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_outline_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_bezel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_bezel_command" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center" android:padding="13dp" android:clipToPadding="false">
        <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="SMART CONSOLE" android:textColor="#F4FAF7" android:textSize="8sp" android:letterSpacing="0.12" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#F4FAF7" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <include layout="@layout/widget_clock_faces" android:layout_width="match_parent" android:layout_height="52dp" />
        <TextView android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:text="◴  NEXT ALARM" android:textColor="#F4FAF7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:text="SMART · LOCAL" android:textColor="#F4FAF7" android:textSize="9sp" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
            <TextView android:id="@+id/widget_action_timer" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="▶  TIMER" android:textColor="#062A2A" android:textSize="10sp" android:fontFamily="sans-serif-black" android:background="@drawable/widget_chip_cyan" />
            <TextView android:id="@+id/widget_action_alarm" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="7dp" android:gravity="center" android:text="◴  ALARMS" android:textColor="#E9FBF8" android:textSize="10sp" android:fontFamily="sans-serif-black" android:background="@drawable/widget_chip_outline" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>