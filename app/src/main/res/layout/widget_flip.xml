<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_widget_flip" android:clipChildren="false">
    <ImageView android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_fill_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_gloss" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_outline_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_bezel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_bezel_flip" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center" android:padding="16dp" android:clipToPadding="false">
        <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="FLIP DECK · LOCAL TIME" android:textColor="#E2F4FF" android:textSize="8sp" android:letterSpacing="0.12" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#E2F4FF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="@drawable/widget_flip_plate">
            <include layout="@layout/widget_clock_faces" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="center_vertical" android:background="#66D8EDFF" />
        </FrameLayout>
        <TextView android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="◴  NEXT ALARM" android:textColor="#E2F4FF" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="LOCAL · READY" android:textColor="#E2F4FF" android:textSize="9sp" android:alpha="0.75" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>