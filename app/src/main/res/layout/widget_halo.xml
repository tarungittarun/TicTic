<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_widget_halo" android:clipChildren="false">
    <ImageView android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_fill_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_gloss" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_outline_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_bezel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_bezel_halo" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center" android:padding="20dp" android:clipToPadding="false">
        <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="HALO ORBIT · TODAY" android:textColor="#E9FCFF" android:textSize="8sp" android:letterSpacing="0.12" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#E9FCFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <include layout="@layout/widget_clock_faces" android:layout_width="match_parent" android:layout_height="56dp" />
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progressTint="#54E3D7" android:progressBackgroundTint="#48636B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" />
        <TextView android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="◴  NEXT ALARM" android:textColor="#E9FCFF" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="DAY 42% · LOCAL" android:textColor="#74E7DD" android:textSize="9sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.08" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>