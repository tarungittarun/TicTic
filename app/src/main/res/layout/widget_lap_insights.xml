<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_widget_stopwatch" android:clipChildren="false">
    <ImageView android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_fill_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_gloss" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_outline_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:clipToPadding="false">
        <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="LAP INSIGHTS" android:textColor="#3F7C73" android:textSize="9sp" android:letterSpacing="0.10" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_concept_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LAP INSIGHTS" android:textSize="9sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="#596E7D" />
        <TextView android:id="@+id/widget_lap_last" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Latest · —" android:textSize="14sp" android:textStyle="bold" android:textColor="#202B32" />
        <TextView android:id="@+id/widget_lap_best" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fastest · —" android:textSize="12sp" android:textColor="#52636D" />
        <TextView android:id="@+id/widget_lap_average" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Average · —" android:textSize="12sp" android:textColor="#52636D" />
        <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#183A34" android:textSize="11sp" android:fontFamily="sans-serif" android:visibility="gone" />
        <include layout="@layout/widget_clock_faces" android:layout_width="match_parent" android:layout_height="42dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="◴  NEXT ALARM" android:textColor="#183A34" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="" android:textColor="#183A34" android:textSize="9sp" android:maxLines="2" android:ellipsize="end" />
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
