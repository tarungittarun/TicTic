<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_widget_bedside" android:clipChildren="false">
    <ImageView android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_fill_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_gloss" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_panel_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_panel_outline_soft" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:clipToPadding="false">
        <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="WAKE SWITCH" android:textColor="#B6D1C7" android:textSize="9sp" android:letterSpacing="0.10" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_concept_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT ALARM" android:textSize="9sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="#B6D1C7" />
        <TextView android:id="@+id/widget_wake_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No alarm saved" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_wake_switch" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center" android:text="ALARM ON · TAP TO PAUSE" android:textSize="10sp" android:textStyle="bold" android:textColor="#173A35" android:background="@drawable/widget_chip_cyan" />
        <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#FFFFFF" android:textSize="11sp" android:fontFamily="sans-serif" android:visibility="gone" />
        <include layout="@layout/widget_clock_faces" android:layout_width="match_parent" android:layout_height="42dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="◴  NEXT ALARM" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="2" android:ellipsize="end" />
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
