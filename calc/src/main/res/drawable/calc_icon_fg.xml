<?xml version="1.0" encoding="utf-8"?>
<!-- The standalone mark in the suite's design language: the default MySpace accent on the
     suite's dark ground. A calculator face -- display bar over a key grid -- drawn in the
     same stroke weight the TicIconView glyphs use, so the icon reads as a sibling of the
     suite's glyphs rather than a sticker on top of them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- display bar -->
    <path
        android:fillColor="#3f7c73"
        android:pathData="M34,30 h40 a4,4 0 0 1 4,4 v8 a4,4 0 0 1 -4,4 h-40 a4,4 0 0 1 -4,-4 v-8 a4,4 0 0 1 4,-4 z" />
    <!-- key grid: three rows of three -->
    <path
        android:fillColor="#57a08c"
        android:pathData="M32,52 h10 v10 h-10 z M49,52 h10 v10 h-10 z M66,52 h10 v10 h-10 z
                          M32,68 h10 v10 h-10 z M49,68 h10 v10 h-10 z M66,68 h10 v10 h-10 z" />
    <!-- the equals key, accent-filled like the one on the pad -->
    <path
        android:fillColor="#7fc0ae"
        android:pathData="M32,84 h44 a4,4 0 0 1 4,4 v4 a4,4 0 0 1 -4,4 h-44 a4,4 0 0 1 -4,-4 v-4 a4,4 0 0 1 4,-4 z" />
</vector>
