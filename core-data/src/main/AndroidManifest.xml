<?xml version="1.0" encoding="utf-8"?>
<!-- The suite's sharing door, declared once for every module. Library manifests merge into
     :app, and ${applicationId} resolves at merge time, so both the full and lite flavours get
     their own authority without repeating this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="app.space.core.data.ShareProvider"
            android:authorities="${applicationId}.myspace_share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
