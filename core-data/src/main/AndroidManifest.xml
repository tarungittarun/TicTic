<?xml version="1.0" encoding="utf-8"?>
<!-- The suite's one sharing door, declared once for every module: AndroidX FileProvider with
     the paths table in res/xml/myspace_paths.xml. Library manifests merge into :app, and
     ${applicationId} resolves at merge time, so both flavours get their own authority. The
     hand-rolled ShareProvider this replaces was a Sprint 3 necessity under
     useAndroidX=false; Sprint 4 adopted AndroidX and the standard component with it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.myspace_files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/myspace_paths" />
        </provider>
    </application>
</manifest>
