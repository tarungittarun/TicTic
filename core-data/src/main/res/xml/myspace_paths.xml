<?xml version="1.0" encoding="utf-8"?>
<!-- The one containment rule for every URI this suite hands to another app: anything under
     getFilesDir() and nothing else. Replaces the hand-rolled canonical-path checks the
     Sprint 3 providers carried; FileProvider enforces this table and refuses everything
     outside it with an IllegalArgumentException instead of a served file. -->
<paths>
    <files-path name="files" path="." />
    <!-- App-specific external storage: where export zips land so they survive a cache clear
         and are reachable over USB. Still nothing any other app can write to. -->
    <external-files-path name="external_files" path="." />
</paths>
