<?xml version="1.0" encoding="utf-8"?>
<!-- Round 9: popups arrive and leave with a fade and a small rise, so opening history,
     memory or the three-dot menu reads as a transition and not a jump cut. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="160"
        android:interpolator="@android:anim/decelerate_interpolator" />
    <translate android:fromYDelta="-2%" android:toYDelta="0" android:duration="160"
        android:interpolator="@android:anim/decelerate_interpolator" />
</set>
