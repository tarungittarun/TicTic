<?xml version="1.0" encoding="utf-8"?>
<!-- Stable ids for the calculator's key views: the UI tests on the emulator address the
     display, the history sheet and the history button by id, because a test that clicks
     "the EditText somewhere" is a test that can pass while the screen is broken. -->
<resources>
    <item name="calc_display" type="id"/>
    <item name="calc_history_scroll" type="id"/>
    <item name="calc_history_btn" type="id"/>
    <item name="calc_dock" type="id"/>
    <item name="calc_pad" type="id"/>
    <item name="calc_chevron_row" type="id"/>
</resources>
