<?xml version="1.0" encoding="utf-8"?>
<!-- Capture rides the suite's one FileProvider door in core-data; all this manifest keeps is
     package visibility. No CAMERA permission is declared on purpose: delegating to the system
     camera app needs none, and declaring it would turn every install into a runtime-permission
     prompt the app then has to handle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- API 30+: without this, resolveActivity says no camera exists on devices that have
         one, and the capture button refuses to work for no true reason. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
