<resources>
    <style name="NotesTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#76551D</item>
        <item name="android:windowBackground">#FAFAF8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAF8</item>
        <item name="android:navigationBarColor">#FAFAF8</item>
        <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/NotesDialogLight</item><item name="android:datePickerDialogTheme">@style/NotesDialogLight</item><item name="android:timePickerDialogTheme">@style/NotesDialogLight</item>
    </style>
<style name="NotesThemeLight" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">#76551D</item><item name="android:windowBackground">#FAFAF8</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">#FAFAF8</item><item name="android:navigationBarColor">#FAFAF8</item><item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/NotesDialogLight</item><item name="android:datePickerDialogTheme">@style/NotesDialogLight</item><item name="android:timePickerDialogTheme">@style/NotesDialogLight</item></style>
<style name="NotesThemeDark" parent="android:style/Theme.Material.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">#E8C58E</item><item name="android:windowBackground">#17191D</item><item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#17191D</item><item name="android:navigationBarColor">#17191D</item><item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/NotesDialogDark</item><item name="android:datePickerDialogTheme">@style/NotesDialogDark</item><item name="android:timePickerDialogTheme">@style/NotesDialogDark</item></style>
<style name="NotesDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
 <item name="android:fontFamily">sans</item><item name="android:colorAccent">#76551D</item><item name="android:colorBackground">#F0F1EE</item><item name="android:windowBackground">@drawable/notes_dialog_surface</item><item name="android:windowMinWidthMajor">60%</item><item name="android:windowMinWidthMinor">92%</item><item name="android:buttonBarButtonStyle">@style/NotesDialogButton</item>
</style>
<style name="NotesDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
 <item name="android:fontFamily">sans</item><item name="android:colorAccent">#E8C58E</item><item name="android:colorBackground">#24272D</item><item name="android:windowBackground">@drawable/notes_dialog_surface</item><item name="android:windowMinWidthMajor">60%</item><item name="android:windowMinWidthMinor">92%</item><item name="android:buttonBarButtonStyle">@style/NotesDialogButton</item>
</style>
<style name="NotesDialogButton" parent="android:style/Widget.Material.Button.Borderless"><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item><item name="android:fontFamily">sans-serif-medium</item></style>
</resources>
