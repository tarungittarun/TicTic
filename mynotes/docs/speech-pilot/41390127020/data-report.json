  "records": [
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0001",
      "text": "Author of the danger trail, Philip Steels, etc.",
      "audio_sha256": "1f7c300199340733daf09fb440c64517047124c2703048a3c6b965a39e17553a",
      "seconds": 3.2350625,
      "file": "data/ksp-arctic_a0001.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0002",
      "text": "Not at this particular case, Tom, apologized Whittemore.",
      "audio_sha256": "2ff5029c6f4ded953b9bb964935913f639e8d6b021fc7c7428d15e605dcab06d",
      "seconds": 3.8450625,
      "file": "data/ksp-arctic_a0002.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0003",
      "text": "For the twentieth time that evening the two men shook hands.",
      "audio_sha256": "0af26fb7e5488ee9536b0e0ae0c56be9f8a598e190faf5c1088d3a6697719708",
      "seconds": 3.5650625,
      "file": "data/ksp-arctic_a0003.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0004",
      "text": "Lord, but I'm glad to see you again, Phil.",
      "audio_sha256": "64af85ce3acf67081178bf9c54bad4dd500743343b1cd7787369347d36c8676b",
      "seconds": 2.825,
      "file": "data/ksp-arctic_a0004.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0005",
      "text": "Will we ever forget it.",
      "audio_sha256": "dbaf077726b438247124a1da8a93159fb314f1980c14463307bf49297a380fea",
      "seconds": 1.835,
      "file": "data/ksp-arctic_a0005.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0006",
      "text": "God bless 'em, I hope I'll go on seeing them forever.",
      "audio_sha256": "e51a6f91182cbc069b4e5a866d9060154b572bed5617132ea7cff2717627ff6f",
      "seconds": 3.7450625,
      "file": "data/ksp-arctic_a0006.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0007",
      "text": "And you always want to see it in the superlative degree.",
      "audio_sha256": "938c80c20f17ed6f7dc709549eef3c977e6edbadfaf1e96b272d524845781709",
      "seconds": 3.125,
      "file": "data/ksp-arctic_a0007.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0008",
      "text": "Gad, your letter came just in time.",
      "audio_sha256": "9c52948d66b7d5eb877e84e56a6dbb5ba50bdf890b2e1602950dade2e4a8e0f9",
      "seconds": 2.5850625,
      "file": "data/ksp-arctic_a0008.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0009",
      "text": "He turned sharply, and faced Gregson across the table.",
      "audio_sha256": "689e62f3b1a2fe07a55d04bb95d4b3ed8d3146c25346ceb59175ee0dc1aacf07",
      "seconds": 3.5450625,
      "file": "data/ksp-arctic_a0009.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0010",
      "text": "I'm playing a single hand in what looks like a losing game.",
      "audio_sha256": "9b2047cb940720c62bbd2f29023728adb346bf43b9a6be5851f0bb4e6ceb23a5",
      "seconds": 3.4550625,
      "file": "data/ksp-arctic_a0010.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0011",
      "text": "If I ever needed a fighter in my life I need one now.",
      "audio_sha256": "aea8992a91ee4b0fc9bca884d2b4862edd494c4988560551d1be49615ab57216",
      "seconds": 3.4750625,
      "file": "data/ksp-arctic_a0011.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0012",
      "text": "Gregson shoved back his chair and rose to his feet.",
      "audio_sha256": "e5a9f4b4e4c76b630dd87dd924a91bf9f447648d653343a7b0d271af740fc636",
      "seconds": 3.2650625,
      "file": "data/ksp-arctic_a0012.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0013",
      "text": "He was a head shorter than his companion, of almost delicate physique.",
      "audio_sha256": "f6884b752a266f4964ec6fd5fb1ab7f61985eeb8ea1faf20f19dcf0164cec170",
      "seconds": 4.0650625,
      "file": "data/ksp-arctic_a0013.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0014",
      "text": "Now you're coming down to business, Phil, he exclaimed.",
      "audio_sha256": "6adb3ed2a594a415569a33720e7f545c318467059e5f41aeb20afa68262ee6dc",
      "seconds": 3.0950625,
      "file": "data/ksp-arctic_a0014.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0015",
      "text": "It's the aurora borealis.",
      "audio_sha256": "0aaf75dc693fc9a453c1e284c8fc2058dec5d034ba56d8c07b3016b8223fd29c",
      "seconds": 2.0550625,
      "file": "data/ksp-arctic_a0015.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0016",
      "text": "There's Fort Churchill, a rifle-shot beyond the ridge, asleep.",
      "audio_sha256": "91b77e5ebe732b6183a884da8c81fe27393616879ec0709696ce011dae10e5eb",
      "seconds": 3.6750625,
      "file": "data/ksp-arctic_a0016.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0017",
      "text": "From that moment his friendship for Belize turns to hatred and jealousy.",
      "audio_sha256": "fc7dba18bc039df0da78cda37fca0f6f5c23dd21e85fb2f4ac2404cfeefd62f0",
      "seconds": 4.1250625,
      "file": "data/ksp-arctic_a0017.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0018",
      "text": "There was a change now.",
      "audio_sha256": "699d7ff27943c98b5ac67851278d02cad54f05e4a8653dd45c15139770c49eaf",
      "seconds": 1.6250625,
      "file": "data/ksp-arctic_a0018.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0019",
      "text": "I followed the line of the proposed railroad, looking for chances.",
      "audio_sha256": "0cccd0426f1b903eed316ea5a2d6c3b9058415d69610290f54ab2694337e3b2c",
      "seconds": 4.215,
      "file": "data/ksp-arctic_a0019.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0020",
      "text": "Clubs and balls and cities grew to be only memories.",
      "audio_sha256": "e1525d65dd617c48b3b78dc4ecb0be1329687d0b429f53a77db5925ca54e6615",
      "seconds": 3.4150625,
      "file": "data/ksp-arctic_a0020.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0021",
      "text": "It fairly clubbed me into recognizing it.",
      "audio_sha256": "b2516e06ff25c4aaaf0a3b84a93206744679a1c02ce6e39736c7ed87b224abd1",
      "seconds": 2.455,
      "file": "data/ksp-arctic_a0021.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0022",
      "text": "Hardly were our plans made public before we were met by powerful opposition.",
      "audio_sha256": "f6884db83ffce46462c93b7ba47c9c29f93ba57606c81ea41bb0a1e28edd1b49",
      "seconds": 4.5950625,
      "file": "data/ksp-arctic_a0022.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0023",
      "text": "A combination of Canadian capital quickly organized and petitioned for the same privileges.",
      "audio_sha256": "18dd98811fb21b3279680d02951dbee14d387d9c15b218f75a9ac5b27482c056",
      "seconds": 5.3150625,
      "file": "data/ksp-arctic_a0023.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0024",
      "text": "It was my reports from the north which chiefly induced people to buy.",
      "audio_sha256": "bfdc0f03e3b2cbb718b9bb5c56aa00a9f1e46d4e15df7fc67f37a2122417febf",
      "seconds": 3.9350625,
      "file": "data/ksp-arctic_a0024.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0025",
      "text": "I was about to do this when cooler judgment prevailed.",
      "audio_sha256": "d78578b02aab121a590cd1e6405343e9ba56d2dab5585d738598c399b85a571a",
      "seconds": 3.355,
      "file": "data/ksp-arctic_a0025.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0026",
      "text": "It occurred to me that there would have to be an accounting.",
      "audio_sha256": "17a653c2396088c5e10cc33415ea1d1deff39d5607cdea0b8fde1ad23284ec5d",
      "seconds": 2.8150625,
      "file": "data/ksp-arctic_a0026.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0027",
      "text": "To my surprise he began to show actual enthusiasm in my favor.",
      "audio_sha256": "5f7a732addcb9cc45c1c7ea6ba25f1e54744b7c2e20da29ac9a7c29f2686dbba",
      "seconds": 3.9650625,
      "file": "data/ksp-arctic_a0027.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0028",
      "text": "Robbery, bribery, fraud, ",
      "audio_sha256": "9781360d3271eaf2b920f598bad1c159c5254c2cb24bcca09d1d169e379c9a3b",
      "seconds": 1.8350625,
      "file": "data/ksp-arctic_a0028.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0029",
      "text": "Their forces were already moving into the north country.",
      "audio_sha256": "dc41caae07be03de8dd2589b0c5cc320de4a468f95c26e20641a037a13011bd5",
      "seconds": 3.1550625,
      "file": "data/ksp-arctic_a0029.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0030",
      "text": "I had faith in them.",
      "audio_sha256": "8fc049272e1e2caabd3949d30e043746cc5cff7fc4b842976cf6db2b329e9617",
      "seconds": 1.5450625,
      "file": "data/ksp-arctic_a0030.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0031",
      "text": "They were three hundred yards apart.",
      "audio_sha256": "b39243421222f12ffee7c8894ddb7d92edb35484a3afbc538ee30eb0d1e9345c",
      "seconds": 2.085,
      "file": "data/ksp-arctic_a0031.wav"
    },
    {
      "split": "train",
      "speaker": "ksp",
      "id": "arctic_a0032",
      "text": "Since then some mysterious force has been fighting us at every step.",
      "audio_sha256": "518a906c8090c5302aa459260a06fd1787cffb4e1c959bca60c461e8965363d8",
      "seconds": 3.805,
      "file": "data/ksp-arctic_a0032.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0001",
      "text": "Gad, do I remember it.",
      "audio_sha256": "295094a2d0181f1969534cb1378877d0689d3fa6aaad534567fc709bd37d5659",
      "seconds": 1.675,
      "file": "data/slt-arctic_b0001.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0002",
      "text": "You got out by fighting, and I through a pretty girl.",
      "audio_sha256": "4400845dcac7058ba06f282cfd4ed557b70e4341a7e9a579e57b0b9e3532cef9",
      "seconds": 3.105,
      "file": "data/slt-arctic_b0002.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0003",
      "text": "I can see that knife now.",
      "audio_sha256": "45b509ef78696dddcf059513fe4bdc540054251ed3cae3d1b9601d79796414aa",
      "seconds": 1.895,
      "file": "data/slt-arctic_b0003.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0004",
      "text": "When I can't see beauty in woman I want to die.",
      "audio_sha256": "ef34a7ccba961fb453e7ab49675feeb3826503ca4ffae0938cda29148f3d6f60",
      "seconds": 3.035,
      "file": "data/slt-arctic_b0004.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0005",
      "text": "His slim fingers closed like steel about Philip's.",
      "audio_sha256": "7b748bf7ef97eb1633e1283883defa0896cd10580bbca4782ba89967a9c6016e",
      "seconds": 3.0050625,
      "file": "data/slt-arctic_b0005.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0006",
      "text": "He seized Gregson by the arm and led him to the door.",
      "audio_sha256": "b680f6aa27ab123ccd1c4278a75b1f6f6383515f86cc1f73cca73bd7f4a6bbc8",
      "seconds": 3.1050625,
      "file": "data/slt-arctic_b0006.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0007",
      "text": "Hear the Indian dogs wailing down at Churchill.",
      "audio_sha256": "9931a55cff93042a73fe5dbc559fa4b2b751686834af66ba76ff7d014f208246",
      "seconds": 2.785,
      "file": "data/slt-arctic_b0007.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0008",
      "text": "Burke himself had criticized it because of the smile.",
      "audio_sha256": "7d012489ef1033bbcbb64a3b43a585da0b7f7e107256eed92218167115818e8c",
      "seconds": 3.105,
      "file": "data/slt-arctic_b0008.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0009",
      "text": "I'd say there was going to be a glorious scrap.",
      "audio_sha256": "cbaec9471f691d188f84080c20c3e5d83093f74c5622b6a957c60a2028f9c644",
      "seconds": 3.015,
      "file": "data/slt-arctic_b0009.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0010",
      "text": "He turned the map to Gregson, pointing with his finger.",
      "audio_sha256": "5ca8289e757a7cfaae84f17f86affef185d59c1afcd3e9ff786ccc713fa3f1ea",
      "seconds": 3.1150625,
      "file": "data/slt-arctic_b0010.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0011",
      "text": "His eyes never took themselves for an instant from his companion's face.",
      "audio_sha256": "88489758bf8c0c13c9aa796f5ce0246d0ed14234f8c63230a7b62fe861246ce7",
      "seconds": 3.9350625,
      "file": "data/slt-arctic_b0011.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0012",
      "text": "Something that Whittemore had not yet said thrilled him.",
      "audio_sha256": "24c45d105f0550e5c423177e90ebdd7f5033a8da11ffd67c75db2a0e71137c24",
      "seconds": 3.035,
      "file": "data/slt-arctic_b0012.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0013",
      "text": "Lakes and rivers, hundreds of them, thousands of them.",
      "audio_sha256": "1b905d8adad91fb358c4273f8bc0b33e2eb8728defc33df8554632afe49f5883",
      "seconds": 3.4950625,
      "file": "data/slt-arctic_b0013.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0014",
      "text": "Whitefish, Gregson, whitefish and trout.",
      "audio_sha256": "5461c04dee318c1f277e11a221a4b44f0c597f6324fd40f265604f508d902b36",
      "seconds": 2.7050625,
      "file": "data/slt-arctic_b0014.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0015",
      "text": "They robbed me a few years later.",
      "audio_sha256": "072f76b59e5b65622f53318d5105538acdcc56d0a59789e38c40d3c8f3baf40c",
      "seconds": 2.1950625,
      "file": "data/slt-arctic_b0015.wav"
    },
    {
      "split": "evaluation",
      "speaker": "slt",
      "id": "arctic_b0016",
      "text": "He chuckled as he pulled out his pipe and began filling it.",
      "audio_sha256": "6bf4280b4588fbd0215a48d79bdc66940ec5c96124c8b5f3c349ac511a2722b5",
      "seconds": 3.1850625,
      "file": "data/slt-arctic_b0016.wav"
    }
  ],
  "speaker_disjoint": true,
  "transcript_disjoint": true,
